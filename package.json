{
  "name": "conquest-sh",
  "version": "0.5.0-beta.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/christopherjnelson/conquest.sh.git"
  },
  "homepage": "https://github.com/christopherjnelson/conquest.sh#readme",
  "bugs": {
    "url": "https://github.com/christopherjnelson/conquest.sh/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "server": "bun run apps/server/src/index.ts",
    "client": "bun run apps/client/src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run test && bun run typecheck",
    "build": "bun run --filter '*' build",
    "screenshots": "bun run scripts/capture-screenshots.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.0"
  }
}
