{
  "name": "conquest-sh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "server": "bun run apps/server/src/index.ts",
    "client": "bun run apps/client/src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run test && bun run typecheck",
    "build": "bun run --filter '*' build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
